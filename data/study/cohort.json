{"about":"Mock anti-PD-1 NSCLC study: 180 discovery patients (Centres A, B) + 120 validation (Centre C). Simulated; seed 2026.","truth":{"response_logit":{"intercept":-0.75,"ifng":0.7,"log2_tmb":0.6,"caf":-0.45},"centred_at":{"ifng":6.0,"tmb":8.0,"caf":4.0},"formula":"logit P(response) = -0.75 + 0.70·(IFN-γ − 6) + 0.60·log2(TMB / 8) -0.45·(CAF − 4)","not_predictive":["pdl1","cd8","prolif","age","sex","centre","smoking (except via TMB)"]},"meta":{"ifng":{"label":"IFN-γ score","unit":"log2 expr.","desc":"Average expression of 12 interferon-gamma / cytotoxic genes (CXCL9, GZMB, ...). Measures how 'hot' the immune response in the tumour is."},"tmb":{"label":"TMB","unit":"mut/Mb","desc":"Tumour mutational burden: mutations per megabase of DNA. More mutations → more neoantigens the immune system can see."},"caf":{"label":"CAF / TGF-β score","unit":"log2 expr.","desc":"Expression of the cancer-associated-fibroblast / TGF-β programme. High = dense stroma that keeps T cells out of the tumour."},"pdl1":{"label":"PD-L1 TPS","unit":"%","desc":"Tumour proportion score: % of tumour cells staining for PD-L1 (the drug's target pathway) by IHC."},"cd8":{"label":"CD8 T cells","unit":"% of cells","desc":"Share of all cells in the sample that are cytotoxic CD8 T cells."},"prolif":{"label":"Proliferation score","unit":"log2 expr.","desc":"Expression of cell-cycle genes (MKI67, TOP2A, ...). How fast the tumour is dividing."},"age":{"label":"Age","unit":"years","desc":"Age at start of treatment."},"smoking":{"label":"Smoking","unit":"","desc":"never / former / current smoker."},"sex":{"label":"Sex","unit":"","desc":"M / F."},"centre":{"label":"Centre","unit":"","desc":"Hospital that enrolled the patient (A and B = discovery; C = external validation)."},"phenotype":{"label":"Immune phenotype","unit":"","desc":"Inflamed (T cells inside tumour), excluded (T cells stuck in stroma) or desert (few T cells). Known from pathology review; hidden from most models."},"response":{"label":"Responded",